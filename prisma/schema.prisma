datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String    // Hashed password
  name      String
  ruc       String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  // SRI Configuration fields
  sriSimulate       Boolean @default(true)
  sriEnvironment    String  @default("1")
  signatureBase64   String?
  signaturePassword String?
  
  // Branch & Establishment configuration
  isBranch             Boolean @default(false)
  parentCompanyRuc     String?
  establishmentCode    String  @default("001")
  emissionPoint        String  @default("002")
  establishmentAddress String  @default("Av. de los Granados N45 y Eloy Alfaro, Quito")
  
  // Custom Profile & Business fields
  province             String  @default("")
  city                 String  @default("")
  whatsapp             String  @default("")
  businessTypes        String[]
  
  products         Product[]
  assets           Asset[]
  invoices         Invoice[]
  purchases        Purchase[]
  withholdings     Withholding[]
  cashTransactions CashTransaction[]
  journalEntries   JournalEntry[]
  categories       Category[]
  employees        Employee[]
  companies        Company[]

  @@map("users")
}

model Product {
  id           String              @id @default(uuid())
  sku          String              @unique
  name         String
  stock        Int                 @default(0)
  cost         Float
  price        Float
  hasIva       Boolean             @default(true)
  userId       String
  user         User                @relation(fields: [userId], references: [id])
  transactions KardexTransaction[]
  categoryId   String?
  category     Category?           @relation(fields: [categoryId], references: [id])
}

model Category {
  id        String    @id @default(uuid())
  name      String
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name, userId])
  @@map("categories")
}

enum TransactionType {
  INGRESS
  EGRESS
}

model KardexTransaction {
  id           String          @id @default(uuid())
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  type         TransactionType
  quantity     Int
  unitCost     Float
  totalCost    Float
  balanceStock Int
  date         DateTime        @default(now())
}

model Asset {
  id            String   @id @default(uuid())
  name          String
  value         Float
  residualValue Float
  yearsOfLife   Int
  purchaseDate  DateTime @default(now())
  userId       String
  user          User     @relation(fields: [userId], references: [id])
  depreciations DepreciationEntry[]
}

enum InvoiceStatus {
  RECEIVED
  AUTHORIZED
  REJECTED
}

model Invoice {
  id          String        @id @default(uuid())
  claveAcceso String        @unique
  clientName  String
  amount      Float
  subtotal    Float         @default(0)
  iva         Float         @default(0)
  status      InvoiceStatus @default(RECEIVED)
  sentToClient Boolean       @default(false)
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  createdAt        DateTime          @default(now())
  withholdings     Withholding[]
  cashTransactions CashTransaction[]
  journalEntries   JournalEntry[]
}

model DepreciationEntry {
  id        String   @id @default(uuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id])
  amount    Float
  period    String   // Format: "YYYY-MM"
  date      DateTime @default(now())
}

model Purchase {
  id           String   @id @default(uuid())
  invoiceNum   String
  claveAcceso  String   @unique
  providerRuc  String
  providerName String
  amount       Float
  subtotal     Float    @default(0)
  iva          Float    @default(0)
  date         DateTime
  synced       Boolean  @default(true)
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  createdAt        DateTime          @default(now())
  withholdings     Withholding[]
  cashTransactions CashTransaction[]
  journalEntries   JournalEntry[]
}

enum WithholdingType {
  RECEIVED
  EMITTED
}

model Withholding {
  id                  String          @id @default(uuid())
  numeroRetencion     String
  claveAcceso         String?         @unique
  type                WithholdingType
  amountRenta         Float           @default(0)
  amountIva           Float           @default(0)
  amountTotal         Float
  date                DateTime
  clientOrProviderRuc  String
  clientOrProviderName String
  
  invoiceId           String?
  invoice             Invoice?        @relation(fields: [invoiceId], references: [id])
  
  purchaseId          String?
  purchase            Purchase?       @relation(fields: [purchaseId], references: [id])
  
  userId              String
  user                User            @relation(fields: [userId], references: [id])
  createdAt           DateTime        @default(now())
}

enum CashTransactionType {
  INGRESS
  EGRESS
}

enum CashTransactionSource {
  SALE
  PURCHASE
  MANUAL
}

model CashTransaction {
  id          String                @id @default(uuid())
  type        CashTransactionType
  source      CashTransactionSource
  amount      Float
  date        DateTime              @default(now())
  description String?
  
  invoiceId   String?
  invoice     Invoice?              @relation(fields: [invoiceId], references: [id])
  
  purchaseId  String?
  purchase    Purchase?             @relation(fields: [purchaseId], references: [id])
  
  userId      String
  user        User                  @relation(fields: [userId], references: [id])
  createdAt   DateTime              @default(now())
}

model JournalEntry {
  id          String             @id @default(uuid())
  description String
  date        DateTime           @default(now())
  type        String             // "SALE", "PURCHASE", "CASH", "DEPRECIATION", "MANUAL"
  invoiceId   String?
  invoice     Invoice?           @relation(fields: [invoiceId], references: [id])
  purchaseId  String?
  purchase    Purchase?          @relation(fields: [purchaseId], references: [id])
  userId      String
  user        User               @relation(fields: [userId], references: [id])
  lines       JournalEntryLine[]
  createdAt   DateTime           @default(now())
}

model JournalEntryLine {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountCode    String       // e.g. "1.01.01"
  accountName    String       // e.g. "Caja/Bancos"
  debit          Float        @default(0)
  credit         Float        @default(0)
}

// Employees: secondary accounts for billing_frontend access
model Employee {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String   // Hashed
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("employees")
}

model Company {
  id             String   @id @default(uuid())
  type           String   // e.g. RUC, Cédula
  identification String
  name           String   // Razón Social
  description    String   // Descripción / Nombre comercial
  dbName         String   // Nombre DB autogenerado
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("companies")
}
